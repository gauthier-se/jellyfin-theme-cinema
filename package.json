{
  "name": "jellyfin-theme-cinema",
  "version": "0.2.0",
  "private": true,
  "description": "A dark, quiet theme for the modern layout of Jellyfin 12",
  "license": "MIT",
  "author": "gauthier-se",
  "repository": {
    "type": "git",
    "url": "https://github.com/gauthier-se/jellyfin-theme-cinema.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 105",
    "edge >= 105",
    "firefox >= 121",
    "safari >= 16",
    "ios_saf >= 16",
    "samsung >= 20",
    "opera >= 91"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "stylelint \"src/**/*.css\" && prettier --check .",
    "format": "stylelint \"src/**/*.css\" --fix && prettier --write .",
    "server:up": "docker compose -f test/compose.yaml up -d --wait",
    "server:seed": "node test/seed.mjs",
    "server:down": "docker compose -f test/compose.yaml down",
    "shots": "node test/shots.mjs",
    "readme-shots": "node test/shots.mjs --dest docs/screenshots --format jpeg --only \"^(home|home-rows|movie|movies|login|mobile-home|mobile-series)$\"",
    "compare": "node test/compare.mjs"
  },
  "devDependencies": {
    "browserslist": "^4.29.3",
    "lightningcss": "^1.33.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
